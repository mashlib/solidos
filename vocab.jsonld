{
  "@context": {
    "dc": "http://purl.org/dc/elements/1.1/",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "owl": "http://www.w3.org/2002/07/owl#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "terms": "http://www.w3.org/2003/06/sw-vocab-status/ns#",
    "solidos": "http://w3id.org/solidos#",
    "description": {
      "@id": "dc:description",
      "@type": "xsd:string"
    },
    "title": {
      "@id": "dc:title",
      "@type": "xsd:string"
    },
    "comment": {
      "@id": "rdfs:comment",
      "@type": "xsd:string"
    },
    "label": {
      "@id": "rdfs:label",
      "@type": "xsd:string"
    },
    "term_status": {
      "@id": "terms:term_status",
      "@type": "xsd:string"
    },
    "type": {
      "@id": "rdf:type",
      "@type": "@id"
    },
    "domain": {
      "@id": "rdfs:domain",
      "@type": "@id"
    },
    "range": {
      "@id": "rdfs:range",
      "@type": "@id"
    },
    "isDefinedBy": {
      "@id": "rdfs:isDefinedBy",
      "@type": "@id"
    },
    "Property": "rdfs:Property",
    "Class": "rdfs:Class"
  },
  "@graph": [
    {
      "@id": "solidos:",
      "@type": "owl:Ontology",
      "title": "SolidOS vocabulary",
      "description": "Vocabulary for SolidOS: data browser panes, type indexes, and related concepts."
    },
    {
      "@id": "solidos:view",
      "@type": [
        "rdfs:Property"
      ],
      "comment": "Links a resource or RDF class to an ES module URL that renders it. The module should export a pane object with canHandle() and render() methods.",
      "label": "view",
      "isDefinedBy": {
        "@id": "solidos:"
      },
      "range": {
        "@id": "xsd:anyURI"
      },
      "term_status": "unstable"
    },
    {
      "@id": "solidos:PublicDocument",
      "@type": "rdfs:Class",
      "comment": "A document registered in a public type index, intended to be discoverable by anyone who can read the index.",
      "label": "Public document",
      "isDefinedBy": {
        "@id": "solidos:"
      },
      "term_status": "unstable"
    },
    {
      "@id": "solidos:PrivateDocument",
      "@type": "rdfs:Class",
      "comment": "A document registered in a private type index, intended to be discoverable only by the user and parties they authorise.",
      "label": "Private document",
      "isDefinedBy": {
        "@id": "solidos:"
      },
      "term_status": "unstable"
    }
  ]
}
